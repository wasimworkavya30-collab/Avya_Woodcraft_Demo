# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Database tier (SQLite file). Created and seeded on first start.
DATABASE_PATH=database/data/avya.sqlite

# Sessions
SESSION_COOKIE=avya_sid
SESSION_TTL_HOURS=12
# Set to true only when the app is served over HTTPS.
SECURE_COOKIES=false

# Seed credentials
ADMIN_EMAIL=admin@avyawoodcraft.in
# Used only to seed the admin password hash; admin sign-in is demo-scope (see README).
ADMIN_PASSWORD=demo-password
# Default PIN for employee sign-in (the approved demo uses 1234).
EMPLOYEE_DEFAULT_PIN=1234
